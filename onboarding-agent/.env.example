# --- Vertex AI (usa os créditos do Google Cloud; credencial via `gcloud auth application-default login`) ---
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=
# 'global' distribui a carga entre regiões e reduz erros 429 (cota)
GOOGLE_CLOUD_LOCATION=global

# --- Ou Gemini via AI Studio (API key) ---
# GOOGLE_GENAI_USE_ENTERPRISE=0
# GOOGLE_API_KEY=

# --- Modelos (qualquer id Gemini, ou provider/model para LiteLLM, ex: anthropic/claude-sonnet-5-5) ---
# Flash em tudo para caber em orçamento pequeno; troque CURATOR_MODEL por um Pro se a qualidade pedir.
TUTOR_MODEL=gemini-2.5-flash
CURATOR_MODEL=gemini-2.5-flash
REVIEWER_MODEL=gemini-2.5-flash
# Raciocínio do Tutor: 1024 equilibra latência e disciplina no uso de tools (ver make eval)
TUTOR_THINKING_BUDGET=1024

# --- Persistência local ---
ONBOARDING_CATALOG_DB=.adk/catalog.db
ONBOARDING_SESSIONS_DB=.adk/sessions.db
ONBOARDING_MEMORY_DB=.adk/memory.db

# Nota mínima (0-1) para considerar um módulo dominado; abaixo disso entra em revisão
ONBOARDING_PASS_SCORE=0.7

# Orçamento por resposta do Tutor (anti-loop de ferramentas)
ONBOARDING_TOOL_CALLS_PER_TOOL=3
ONBOARDING_TOOL_CALLS_PER_TURN=10
ONBOARDING_MAX_LLM_CALLS=15

# Busca na base: keyword (padrão) ou vector (embeddings Gemini; rode `make kb-index` antes)
ONBOARDING_KB_BACKEND=keyword
ONBOARDING_EMBED_MODEL=gemini-embedding-001
ONBOARDING_KB_MIN_SIMILARITY=0.55
